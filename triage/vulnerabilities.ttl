triage:lapack-3
    a triage:Statement ;
    vex:product <pkg:nix/lapack@3> ;
    vex:vulnerability nvd:CVE-2021-4048 ;
    vex:status "fixed" ;
    vex:statusNotes """
        vulnix sees nixpkgs' lapack interface package, whose version string ('3') is the LAPACK API version, not the real implementation. passthru.implementation confirms this resolves to openblas 0.3.33 — the fix landed in OpenBLAS 0.3.18 and upstream LAPACK 3.10.1.
        """ ;
    rdfs:seeAlso <https://github.com/huwd/declarative_laptop/issues/39> .

