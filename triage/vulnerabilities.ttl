triage:glibc-2.42-84
    a triage:Statement ;
    vex:product <pkg:nix/glibc@2.42-84> ;
    vex:vulnerability nvd:CVE-2025-15281 , nvd:CVE-2026-4046 , nvd:CVE-2026-4437 , nvd:CVE-2026-4438 , nvd:CVE-2026-5435 , nvd:CVE-2026-5450 , nvd:CVE-2026-5928 , nvd:CVE-2026-6238 ;
    vex:status "fixed" ;
    vex:statusNotes """
        All eight fixed by backports in nixpkgs' 2.42-master.patch (release branch): wordexp WRDE_REUSE, IBM1390/1399 iconv, resolv record count / hostname check / ns_sprintrrf x2, scanf %mc, ungetwc.
        """ ;
    rdfs:seeAlso <https://github.com/huwd/declarative_laptop/issues/17> .

triage:glibc-2.44-57
    a triage:Statement ;
    vex:product <pkg:nix/glibc@2.44-57> ;
    vex:vulnerability nvd:CVE-2026-5435 , nvd:CVE-2026-6238 ;
    vex:status "fixed" ;
    vex:statusNotes """
        Same two CVEs as glibc-2.42-84 (GLIBC-SA-2026-0011/0012, in the deprecated ns_print functions) but not fixed by a backport here: the upstream glibc-2.44 tag's resolv/ns_print.c no longer contains a TSIG case, so the CVE-2026-5435 overflow is gone from the release itself, and NVD scopes CVE-2026-6238 to 2.0.1 through 2.43. nixpkgs' 2.44-master.patch only deletes the advisory text files. vulnix can't see either because CVE-2026-5435 has no end version in its CPE.
        Replaces the glibc-2.44-25 entry, whose claim that the 2.44-master.patch carries the fixes does not hold.
        """ ;
    rdfs:seeAlso <https://github.com/huwd/declarative_laptop/pull/60> .

