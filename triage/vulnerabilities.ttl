triage:thrift-0.24.0
    a triage:Statement ;
    vex:product <pkg:nix/thrift@0.24.0> ;
    vex:vulnerability nvd:CVE-2021-24028 ;
    vex:status "not_affected" ;
    vex:justification "component_not_present" ;
    vex:statusNotes """
        Facebook Thrift (Meta's fbthrift, date-versioned YYYY.MM.DD.NN) SSL cert validation bug — unrelated codebase from Apache Thrift 0.x, same false positive already identified under thrift-0.22.0. framework-13 resolves thrift to 0.24.0 (dell-xps-13-9343 still resolves 0.22.0); the other 25 CVEs whitelisted under thrift-0.22.0 no longer apply here — 0.24.0 already contains those fixes, so vulnix doesn't flag them.
        """ ;
    rdfs:seeAlso <https://github.com/huwd/declarative_laptop/pull/60> .

triage:thrift-0.25.0
    a triage:Statement ;
    vex:product <pkg:nix/thrift@0.25.0> ;
    vex:vulnerability nvd:CVE-2021-24028 ;
    vex:status "not_affected" ;
    vex:justification "component_not_present" ;
    vex:statusNotes """
        NVD CPE false positive, the same one recorded under thrift-0.24.0: CVE-2021-24028 is Facebook Thrift (Meta's fbthrift, date-versioned YYYY.MM.DD.NN), affected before 2021.02.22.00, an unrelated codebase from Apache Thrift 0.x. vulnix reads 0.25.0 as lower than a 2021 date.
        On framework-13 it is reached only through open-webui, python3.14-pyarrow and arrow-cpp.
        """ .

triage:zlib-1.3.2
    a triage:Statement ;
    vex:product <pkg:nix/zlib@1.3.2> ;
    vex:vulnerability nvd:CVE-2026-27820 , nvd:CVE-2023-6992 ;
    vex:status "not_affected" ;
    vex:justification "component_not_present" ;
    vex:statusNotes """
        NVD CPE false positives.
        CVE-2026-27820 is in the Ruby zlib gem (Zlib::GzipReader#ungetc), a separate codebase from the C zlib library nixpkgs ships.
        CVE-2023-6992 only affects Cloudflare's zlib fork; upstream zlib (what nixpkgs ships) was confirmed unaffected by the reporter.
        """ .


triage:firefox-other-products
    a triage:Statement ;
    vex:product <pkg:nix/firefox> ;
    vex:vulnerability nvd:CVE-2007-3670 , nvd:CVE-2007-4013 , nvd:CVE-2009-1597 , nvd:CVE-2009-4102 , nvd:CVE-2014-6492 ;
    vex:status "not_affected" ;
    vex:justification "component_not_present" ;
    vex:statusNotes """
        Found only by grype, because each NVD record lists mozilla:firefox with no version bound, so it matches every Firefox release.
        Each is a bug in another product that runs alongside Firefox, none of which is in this closure.
        CVE-2007-3670 is an argument injection in Internet Explorer on Windows when it launches firefox.exe.
        CVE-2007-4013 is in Citrix Access Gateway DLLs installed in a Firefox plugin directory.
        CVE-2009-1597 bypasses Adobe Acrobat's JavaScript restrictions through an inline PDF, and CVE-2014-6492 is in Oracle's Java SE browser plugin: Firefox has not loaded NPAPI plugins such as these since version 52.
        CVE-2009-4102 is in the Sage 1.4.3 RSS extension, which is not installed.
        Re-checked against NVD on 2026-11-22.
        """ ;
    rdfs:seeAlso <https://github.com/huwd/declarative_laptop/pull/145> .


# ── Not affected: the vulnerable code is absent or never runs here ────────────

