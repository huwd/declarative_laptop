# Vulnerability triage for this repository's NixOS systems (ADR 0024).
#
# One RDF graph, using OpenVEX's vocabulary, holds every triage decision.
# `nix build .#vuln-triage` validates it against triage/shapes.ttl and
# compiles it into each scanner's format. docs/vulnerability-triage.md
# explains how to write a statement.

@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix vex:    <https://openvex.dev/ns/v0.2.0#> .
@prefix nvd:    <https://nvd.nist.gov/vuln/detail/> .
@prefix triage: <https://huwd.github.io/declarative_laptop/ns/triage#> .


# ── Wrong product: NVD's CPE matches an unrelated project with the same name ───

triage:ada
    a triage:Statement ;
    vex:product <pkg:nix/ada> ;
    vex:vulnerability nvd:CVE-2024-9410 ;
    vex:status "not_affected" ;
    vex:justification "component_not_present" ;
    vex:statusNotes """
        Ada.cx's Sentry SSRF (a web service). nixpkgs ada is the WHATWG URL parser C++ library.
        """ ;
    rdfs:seeAlso <https://github.com/huwd/declarative_laptop/issues/17> .

triage:bolt
    a triage:Statement ;
    vex:product <pkg:nix/bolt> ;
    vex:vulnerability nvd:CVE-2021-27367 , nvd:CVE-2022-31321 , nvd:CVE-2023-5214 , nvd:CVE-2025-34086 ;
    vex:status "not_affected" ;
    vex:justification "component_not_present" ;
    vex:statusNotes """
        Bolt CMS (PHP) and Puppet Bolt. nixpkgs bolt is the Thunderbolt device manager daemon.
        """ ;
    rdfs:seeAlso <https://github.com/huwd/declarative_laptop/issues/17> .

triage:codex
    a triage:Statement ;
    vex:product <pkg:nix/codex> ;
    vex:vulnerability nvd:CVE-2021-43635 ;
    vex:status "not_affected" ;
    vex:justification "component_not_present" ;
    vex:statusNotes """
        CVE is for codexnotes' Codex notebook web app (XSS via Notebook/Page name field). nixpkgs codex is OpenAI's CLI coding agent — unrelated product, same name.
        """ ;
    rdfs:seeAlso <https://github.com/huwd/declarative_laptop/issues/45> .

triage:dbus-1
    a triage:Statement ;
    vex:product <pkg:nix/dbus@1> ;
    vex:vulnerability nvd:CVE-2022-42010 , nvd:CVE-2022-42011 , nvd:CVE-2022-42012 ;
    vex:status "not_affected" ;
    vex:justification "component_not_present" ;
    vex:statusNotes """
        vulnix parses the 'dbus-1' config derivation as dbus version 1.
        Real dbus is 1.16.2; these were fixed in 1.14.4.
        """ ;
    rdfs:seeAlso <https://github.com/huwd/declarative_laptop/issues/17> .

triage:game-music-emu
    a triage:Statement ;
    vex:product <pkg:nix/game-music-emu> ;
    vex:vulnerability nvd:CVE-2026-0016 , nvd:CVE-2026-0017 , nvd:CVE-2026-0018 ;
    vex:status "not_affected" ;
    vex:justification "component_not_present" ;
    vex:statusNotes """
        NVD lists libgme:game_music_emu alongside Android, but all three descriptions are bugs in AOSP Java services (BiometricService, AccessibilityManagerService, CredentialManagerService). game-music-emu is a C++ chip-music library with none of that code, and it is only in the closure through gst-plugins-bad for the thumbnailer.
        Treated as NVD data errors from an Android security bulletin.
        """ .

