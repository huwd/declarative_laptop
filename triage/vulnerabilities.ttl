    vex:product <pkg:nix/avahi> ;
    vex:vulnerability nvd:CVE-2021-26720 ;
    vex:status "not_affected" ;
    vex:justification "vulnerable_code_not_present" ;
    vex:statusNotes """
        Only affects Debian's packaging (avahi-daemon-check-dns.sh run from /etc/network/if-up.d);
        NixOS doesn't ship that script.
        """ ;
    rdfs:seeAlso <https://github.com/huwd/declarative_laptop/issues/17> .

